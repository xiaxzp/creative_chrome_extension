{
  "name": "wxt-react-starter",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "ts-node": {
    "esm": true
  },
  "scripts": {
    "generate": "node --loader ts-node/esm scripts/generate.ts",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
